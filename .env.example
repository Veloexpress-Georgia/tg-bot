APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://veloexpress:veloexpress@localhost:5432/veloexpress

TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_IDS=
TELEGRAM_TARGET_CHAT_ID=
TELEGRAM_TARGET_THREAD_ID=
TELEGRAM_PAYMENTS_THREAD_ID=
TELEGRAM_PIN_POLL=true
SCHEDULE_TIMEZONE=Asia/Tbilisi
# Bootstrap defaults. Admins can change price and deadline at runtime for future days.
PAYMENT_PRICE_GEL=20
BOOKING_DEADLINE_TIME=20:00
PAYMENTS_VIA_PRIVATE_CHAT=false

# Optional container healthcheck tuning. Dockerfile/Compose set these defaults.
# APP_HEALTH_HEARTBEAT_FILE=/tmp/veloexpress-bot-heartbeat.json
# APP_HEALTH_HEARTBEAT_INTERVAL_SECONDS=15
# APP_HEALTH_MAX_AGE_SECONDS=90
# APP_HEALTH_REQUIRE_WORKER=true
# APP_HEALTH_WORKER_MAX_AGE_SECONDS=120

# Browser/API. Generate a random secret: python -c "import secrets; print(secrets.token_urlsafe(48))"
WEB_SESSION_SECRET=
WEB_PUBLIC_URL=http://localhost:5173
# HTTPS URL enables the bot's Mini App menu after deployment.
WEB_APP_URL=
# Optional browser login: configure Login Widget in BotFather, use RS256.
WEB_TELEGRAM_CLIENT_ID=
WEB_TELEGRAM_CLIENT_SECRET=
